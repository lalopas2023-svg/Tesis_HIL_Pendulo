# Los CSV que respaldan un resultado de la bitácora sí se versionan (están en analisis/).
analisis/datos_sin_perturbacion_20[0-9][0-9][0-9][0-9][0-9][0-9]_[0-9][0-9][0-9][0-9][0-9][0-9].csv
analisis/datos_con_perturbacion_20[0-9][0-9][0-9][0-9][0-9][0-9]_[0-9][0-9][0-9][0-9][0-9][0-9].csv
analisis/datos_sin_perturbacion.csv
analisis/datos_con_perturbacion.csv

